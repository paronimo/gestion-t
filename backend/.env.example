# Ejemplo de variables de entorno del backend.
# Copiá este archivo como backend/.env y completá con tus datos reales.
# El archivo .env está en .gitignore: nunca se sube al repositorio.

# Opción A (recomendada): ruta al archivo JSON de cuenta de servicio.
# El archivo tampoco se sube al repositorio.
FIREBASE_SERVICE_ACCOUNT=./credentials/serviceAccount.json

# Opción B: credenciales por partes, si preferís no usar un archivo.
# FIREBASE_PROJECT_ID=gedistorio
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@gedistorio.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
